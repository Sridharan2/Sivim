# Copy to .env.local. All values below are PUBLIC, embedded at build time.
# Restart development after editing; rebuild/redeploy the static export.
# Never put passwords, API secrets or private keys in NEXT_PUBLIC_ variables.

# Company and branding
NEXT_PUBLIC_COMPANY_NAME="SIVIM"
NEXT_PUBLIC_SITE_URL="https://sivim.in"
NEXT_PUBLIC_BRAND_TAGLINE="Security, covered."
NEXT_PUBLIC_COMPANY_DESCRIPTION="CCTV cameras, recording systems, networking products and installation solutions. Thoughtful security, from the first lens to the last cable."
NEXT_PUBLIC_LOGO_PATH="/assets/logo.png"
NEXT_PUBLIC_LOGO_MARK_PATH="/assets/logo-mark.png"

# About figures: these are illustrative samples, not verified company totals.
# Whole numbers only: projects 0-999999, experience 0-100 years.
NEXT_PUBLIC_ONGOING_PROJECTS=8
NEXT_PUBLIC_COMPLETED_PROJECTS=250
NEXT_PUBLIC_YEARS_EXPERIENCE=10
# Set true only after replacing ALL three figures with verified totals.
# False (or empty) keeps the public "Illustrative figures" label visible.
NEXT_PUBLIC_STATS_VERIFIED=false

# Contact card: add up to two optional additional numbers
NEXT_PUBLIC_PHONE_PRIMARY="+91 63829 10322"
NEXT_PUBLIC_PHONE_SECONDARY="+91 94459 37998"
NEXT_PUBLIC_PHONE_LANDLINE=
NEXT_PUBLIC_CONTACT_EMAIL="deenadayalan@sivim.in"
NEXT_PUBLIC_SUPPORT_EMAIL="support@sivim.in"
NEXT_PUBLIC_WHATSAPP_NUMBER="916382910322"
NEXT_PUBLIC_CONTACT_ADDRESS="174/2, Mannarsamy Koil Street, Royapuram, Chennai"
NEXT_PUBLIC_STREET_ADDRESS="174/2, Mannarsamy Koil Street, Royapuram"
NEXT_PUBLIC_CITY="Chennai"
NEXT_PUBLIC_REGION="Tamil Nadu"
NEXT_PUBLIC_COUNTRY="IN"
NEXT_PUBLIC_BUSINESS_HOURS="Mon–Fri, 9 AM–9 PM"
NEXT_PUBLIC_OPEN_DAYS="Monday,Tuesday,Wednesday,Thursday,Friday"
NEXT_PUBLIC_OPEN_TIME="09:00"
NEXT_PUBLIC_CLOSE_TIME="21:00"

# Optional Google Maps directions URL; empty derives it from CONTACT_ADDRESS.
NEXT_PUBLIC_MAP_URL=https://www.google.com/maps/place/174,+Mannarsamy+Koil+St,+Bhogipalayam,+Choolai,+Chennai,+Tamil+Nadu+600012/@13.1004522,80.2587886,17z/data=!3m1!4b1!4m5!3m4!1s0x3a5265ec15b00dff:0xc6b981d4ca394ee6!8m2!3d13.100447!4d80.2613635?entry=ttu&g_ep=EgoyMDI2MTEwMi4wIKXMDSoASAFQAw%3D%3D
# Paste only the HTTPS src URL from Google Maps > Share > Embed a map.
# Empty displays the address and a directions link without loading a map.
NEXT_PUBLIC_MAP_EMBED_URL=https://www.google.com/maps/place/174,+Mannarsamy+Koil+St,+Bhogipalayam,+Choolai,+Chennai,+Tamil+Nadu+600012/@13.1004522,80.2587886,17z/data=!3m1!4b1!4m5!3m4!1s0x3a5265ec15b00dff:0xc6b981d4ca394ee6!8m2!3d13.100447!4d80.2613635?entry=ttu&g_ep=EgoyMDI2MTEwMi4wIKXMDSoASAFQAw%3D%3D

# Optional official social profiles, HTTPS on the matching platform only
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/sivimcctv/
NEXT_PUBLIC_FACEBOOK_URL=https://www.instagram.com/sivimcctv/
NEXT_PUBLIC_YOUTUBE_URL=https://www.instagram.com/sivimcctv/
